<?xml version="1.0" encoding="utf-8"?>
<!--
  A test-only app: an accessibility service that writes the screen as XML for
  the live harness. It is a separate package on purpose — an accessibility
  service is a sensitive permission and has no business in the proxy the phone
  actually runs, and a test package can be installed and removed by the harness
  without touching the app under test.

  Both the service and the receiver are exported: the service because the
  system binds it, the receiver because adb is a different uid and is the only
  thing that ever sends it an intent. That is also why nothing here is guarded
  by a signature permission — it is a dumper for a personal test phone, and it
  can only read what accessibility can read anyway.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.phonelink.capture"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".DumpService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dump_service" />
        </service>

        <receiver
            android:name=".DumpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.phonelink.capture.DUMP" />
                <action android:name="org.phonelink.capture.WATCH" />
                <action android:name="org.phonelink.capture.TAP" />
                <action android:name="org.phonelink.capture.SWIPE" />
                <action android:name="org.phonelink.capture.BACK" />
                <action android:name="org.phonelink.capture.HOME" />
                <action android:name="org.phonelink.capture.FLASH" />
                <action android:name="org.phonelink.capture.WAIT" />
                <action android:name="org.phonelink.capture.SEQUENCE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
