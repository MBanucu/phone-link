<?xml version="1.0" encoding="utf-8"?>
<!--
  Control surface: `adb shell am start-foreground-service` only.

  The service is exported and guarded by android.permission.DUMP, which the
  shell user holds and ordinary apps do not, so a wired or wireless adb session
  can start and stop the listener without the phone being unlocked, and nothing
  else on the network can.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.phonelink.proxy"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- requestNetwork(), as opposed to registerNetworkCallback(), counts as a
         change: without this the first cellular request throws SecurityException. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The SSID of the current Wi-Fi is redacted without location permission
         and location switched on; the uplink predicate matches on it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- A tile click is user interaction, which is enough to start a foreground
         service, but Android still rejects the location service type unless the
         app may hold location while it is in the background. Grant "Allow all
         the time"; without it the tile starts the proxy with the SSID hidden
         and the listener stays shut. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_stat_proxy"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One type only: location, which is what makes the SSID readable while
             the app is not in front. A second `specialUse` type would read as
             more honest for a proxy, but Android 15 then refuses to start the
             service from BOOT_COMPLETED, which is exactly where auto_start
             needs it. -->
        <service
            android:name=".ProxyService"
            android:exported="true"
            android:foregroundServiceType="location"
            android:permission="android.permission.DUMP" />

        <!-- Quick Settings tile: the system binds it, so the permission is the
             contract rather than a gate we apply. -->
        <service
            android:name=".ProxyTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_proxy"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
