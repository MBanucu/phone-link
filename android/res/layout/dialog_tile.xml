<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/SectionHeader"
            android:text="@string/tile_start_label" />

        <RadioGroup
            android:id="@+id/start_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/start_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_tile" />

            <RadioButton
                android:id="@+id/start_in_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_in_use" />

            <RadioButton
                android:id="@+id/start_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_all_saved" />
        </RadioGroup>

        <TextView
            style="@style/SectionHeader"
            android:paddingTop="12dp"
            android:text="@string/tile_cycle_label" />

        <LinearLayout
            android:id="@+id/tile_cycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cycle_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_tile" />

            <CheckBox
                android:id="@+id/cycle_in_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_in_use" />

            <CheckBox
                android:id="@+id/cycle_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_all_saved" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:paddingTop="12dp"
            android:text="@string/tile_stop_label" />

        <RadioGroup
            android:id="@+id/stop_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/stop_tile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_started" />

            <RadioButton
                android:id="@+id/stop_in_use"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_in_use" />

            <RadioButton
                android:id="@+id/stop_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_scope_every" />
        </RadioGroup>

        <TextView
            style="@style/SectionHeader"
            android:paddingTop="12dp"
            android:text="@string/tile_profiles_label" />

        <LinearLayout
            android:id="@+id/tile_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/tile_settings_footnote"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>
</ScrollView>
