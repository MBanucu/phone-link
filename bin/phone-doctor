#!/usr/bin/env bash
# Check every runtime condition the phone-link setup needs: host forwarding and
# the AP profile, adb and the phone's Wi-Fi link, the secrets, the proxy, the
# tunnel, the USB tether and the internet. Read-only: nothing is started,
# enabled or changed.
#
#   phone-doctor            report every condition
#   phone-doctor --analyze  only the problems, as "status id detail" lines
#
# Exit 0 when every required condition is met, 1 otherwise; optional
# conditions (USB tether, adb over Wi-Fi, the tunnel service) only warn.
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/phone-net.sh"

usage() {
  cat >&2 <<'EOF'
usage: phone-doctor [--analyze]

Checks the runtime conditions of the whole phone-link setup. Read-only.
--analyze prints one "fail|warn ID detail" line per problem for scripts such as
phone-doctor-fix; without it the report is grouped and human-readable. Exits 0
when every required condition is met and 1 otherwise.
EOF
}

analyze=0
while [ $# -gt 0 ]; do
  case $1 in
    --analyze) analyze=1 ;;
    -h | --help) usage; exit 0 ;;
    *)
      usage
      die "unknown argument: $1"
      ;;
  esac
  shift
done

ap_if=${PHONE_AP_IF:-wlp110s0}
resolv=${PHONE_DOCTOR_RESOLV:-/etc/resolv.conf}
probe_url=${PHONE_DOCTOR_URL:-https://example.com}

n_ok=0
n_fail=0
n_warn=0

section() {
  if [ "$analyze" = 0 ]; then printf '\n%s\n' "$1"; fi
}

# emit STATUS ID DISPLAY DETAIL -> grouped line, or an analyze problem line.
emit() {
  status=$1
  id=$2
  display=$3
  detail=$4
  case $status in
    ok)
      n_ok=$((n_ok + 1))
      if [ "$analyze" = 0 ]; then printf 'ok    %-20s %s\n' "$display" "$detail"; fi
      ;;
    warn)
      n_warn=$((n_warn + 1))
      if [ "$analyze" = 1 ]; then
        printf 'warn %s %s\n' "$id" "$detail"
      else
        printf 'warn  %-20s %s\n' "$display" "$detail"
      fi
      ;;
    fail)
      n_fail=$((n_fail + 1))
      if [ "$analyze" = 1 ]; then
        printf 'fail %s %s\n' "$id" "$detail"
      else
        printf 'FAIL  %-20s %s\n' "$display" "$detail"
      fi
      ;;
    skip)
      if [ "$analyze" = 0 ]; then printf 'skip  %-20s %s\n' "$display" "$detail"; fi
      ;;
  esac
}

section '[host]'
forward=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || true)
if [ "$forward" = 1 ]; then
  emit ok ip_forward "ip_forward" "1"
else
  emit fail ip_forward "ip_forward" "${forward:-unknown} (set net.ipv4.ip_forward = 1)"
fi

ap_addr=$(ip -4 -br addr show "$ap_if" 2>/dev/null | awk '{print $3}' | head -1 || true)
ap_mode=0
if [ -n "$ap_addr" ]; then ap_mode=1; fi

if nmcli -t -f NAME con show 2>/dev/null | grep -Fxq "$PHONE_AP_CON"; then
  emit ok ap_profile "ap profile" "$PHONE_AP_CON"
elif [ "$ap_mode" = 1 ]; then
  emit fail ap_profile "ap profile" "$PHONE_AP_CON missing"
else
  emit warn ap_profile "ap profile" "$PHONE_AP_CON missing (hotspot mode)"
fi

if [ "$ap_mode" = 1 ]; then
  emit ok ap_address "ap address" "$ap_if $ap_addr"
else
  emit warn ap_address "ap address" "$ap_if has no IPv4 (hotspot mode)"
fi

nameservers=$(awk '/^nameserver/ {printf "%s ", $2}' "$resolv" 2>/dev/null || true)
case $nameservers in
  *1.1.1.1*9.9.9.9* | *9.9.9.9*1.1.1.1*) emit ok resolver "resolver" "$nameservers" ;;
  *) emit warn resolver "resolver" "${nameservers:-none} (the module pins 1.1.1.1/9.9.9.9)" ;;
esac

if [ "$ap_mode" = 1 ]; then
  target=$PHONE_AP_IP
else
  target=$PHONE_HOTSPOT_IP
fi

section '[phone]'
serial=$(phone_serial 2>/dev/null) || serial=""
if [ -n "$serial" ]; then
  emit ok adb_device "adb device" "$serial"
else
  emit fail adb_device "adb device" "none (see adb devices)"
fi

if [ -n "$serial" ]; then
  keyguard=$(adb -s "$serial" shell dumpsys window policy 2>/dev/null \
    | tr -d '\r' | sed -n 's/^ *showing=\(true\|false\)$/\1/p' | head -1 || true)
  case $keyguard in
    false) emit ok phone_unlocked "phone unlocked" "yes" ;;
    true) emit warn phone_unlocked "phone unlocked" "no (run phone-unlock)" ;;
    *) emit warn phone_unlocked "phone unlocked" "unknown" ;;
  esac

  ips=$(phone_ips 2>/dev/null || true)
  if printf '%s\n' "$ips" | grep -Fxq "$target"; then
    emit ok phone_address "phone address" "$target"
  else
    emit fail phone_address "phone address" \
      "$target not on the phone (has: $(printf '%s\n' "$ips" | tr '\n' ' '))"
  fi

  default_route=$(adb -s "$serial" shell ip route show default 2>/dev/null \
    | tr -d '\r' | head -1 || true)
  if [ -n "$default_route" ]; then
    emit ok phone_default "phone default" "$default_route"
  else
    emit fail phone_default "phone default" "no default route (mobile data off?)"
  fi
else
  emit skip phone_unlocked "phone unlocked" "no adb"
  emit skip phone_address "phone address" "no adb"
  emit skip phone_default "phone default" "no adb"
fi

section '[secrets]'
if [ -r "$PHONE_SECRETS" ]; then
  keys=$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$PHONE_SECRETS" 2>/dev/null | tr -d '=' || true)
  missing=""
  for key in PHONE_SOCKS_PASS PHONE_PIN; do
    printf '%s\n' "$keys" | grep -Fxq "$key" || missing="$missing $key"
  done
  if [ -z "$missing" ]; then
    emit ok secrets "secrets" "$PHONE_SECRETS"
  else
    emit fail secrets "secrets" "missing$missing"
  fi
  if printf '%s\n' "$keys" | grep -Fxq PHONE_AP_PASS; then
    emit ok ap_pass "secrets" "PHONE_AP_PASS present"
  else
    emit warn ap_pass "secrets" "PHONE_AP_PASS missing (phone-wifi-connect needs it)"
  fi
else
  emit fail secrets "secrets" "$PHONE_SECRETS not readable (run with sudo)"
fi

section '[proxy]'
if [ -n "$serial" ]; then
  if adb -s "$serial" shell pm path "$PHONE_PROXY_PKG" 2>/dev/null | grep -q '^package:'; then
    emit ok proxy_app "proxy app" "$PHONE_PROXY_PKG"
  else
    emit fail proxy_app "proxy app" "$PHONE_PROXY_PKG not installed"
  fi
else
  emit skip proxy_app "proxy app" "no adb"
fi

if pass=$(phone_proxy_pass 2>/dev/null); then
  code=$(timeout 20 curl -4 -s -m 20 -o /dev/null -w '%{http_code}' \
    --socks5-hostname "$PHONE_PROXY_USER:$pass@$target:$PHONE_PROXY_PORT" \
    "$probe_url" 2>/dev/null || true)
  if [ "$code" = 200 ]; then
    emit ok proxy_request "proxy request" "$target:$PHONE_PROXY_PORT -> 200"
  else
    emit fail proxy_request "proxy request" "$target:$PHONE_PROXY_PORT -> ${code:-000}"
  fi
else
  emit fail proxy_request "proxy request" "no PHONE_SOCKS_PASS (run with sudo)"
fi

section '[tunnel]'
tunnel=$(systemctl is-active phone-tun.service 2>/dev/null || true)
if [ "$tunnel" = active ]; then
  emit ok phone_tun "phone-tun" "active"
  if ip rule show 2>/dev/null | grep -q 2022; then
    emit ok tunnel_route "tunnel route" "table 2022"
  else
    emit warn tunnel_route "tunnel route" "no 2022 ip rule"
  fi
else
  emit warn phone_tun "phone-tun" "${tunnel:-unknown} (the timer starts it when the proxy answers)"
fi

section '[usb tether]'
if [ -n "$serial" ]; then
  rndis=$(adb -s "$serial" shell ip -4 -o addr show rndis0 2>/dev/null \
    | tr -d '\r' | awk '{print $4}' | head -1 || true)
  if [ -n "$rndis" ]; then
    emit ok rndis0 "rndis0" "$rndis"
  else
    emit warn rndis0 "rndis0" "no address (USB tether off)"
  fi
else
  emit skip rndis0 "rndis0" "no adb"
fi

section '[internet]'
code=$(timeout 20 curl -4 -s -m 20 -o /dev/null -w '%{http_code}' \
  "$probe_url" 2>/dev/null || true)
if [ "$code" = 200 ]; then
  emit ok https "https" "$probe_url -> 200"
else
  emit fail https "https" "$probe_url -> ${code:-000}"
fi

section '[adb over wi-fi]'
if transport=$(adb_transport 2>/dev/null); then
  emit ok network_transport "network transport" "$transport"
else
  emit warn network_transport "network transport" "USB only (phone-adb-wifi)"
fi

if [ "$analyze" = 1 ]; then
  if [ "$n_fail" -gt 0 ]; then exit 1; fi
  exit 0
fi

printf '\n%d ok, %d failed, %d warnings\n' "$n_ok" "$n_fail" "$n_warn"
if [ "$n_fail" -gt 0 ]; then
  printf 'verdict: setup is not ready (%d required condition(s) failed)\n' "$n_fail" >&2
  exit 1
fi
if [ "$n_warn" -gt 0 ]; then
  printf 'verdict: required conditions are met; %d optional condition(s) open\n' "$n_warn"
else
  printf 'verdict: the whole setup is ready\n'
fi
