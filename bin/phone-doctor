#!/usr/bin/env bash
# The doctor lives in ../lib/python/phone_doctor (one module per symptom group).
# This wrapper only resolves the package next to the checkout or the store
# install, then hands over to it.
set -eu

here=$(dirname -- "$(readlink -f -- "$0")")
export PYTHONPATH="$here/../lib/python${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
exec python3 -m phone_doctor "$@"
