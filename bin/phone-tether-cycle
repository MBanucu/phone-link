#!/usr/bin/env bash
# Disable USB tethering, run the internet health check, enable USB tethering
# again and report what happened.
#
#   phone-tether-cycle            # asks first
#   phone-tether-cycle --yes      # no prompt
#
# This phone refuses RNDIS while the keyguard is up and it ignores
# `svc usb setFunctions adb`, so the cycle switches USB to MTP (RNDIS off, adb
# stays up) and restores the tether the same way phone-reboot-unlock does:
# make rndis,adb the screen-unlocked default, switch to charging (a blank
# setFunctions), then lock and unlock the phone, which applies that default.
# phone-unlock reads PHONE_PIN from the environment or the root-only secrets
# file, so run this with sudo unless PHONE_PIN is exported.
#
# If the tether is the laptop's only uplink, the laptop loses internet for the
# duration of the health check; the traps put RNDIS back even when the script
# is interrupted.
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/phone-net.sh"
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/phone-ui.sh"

usage() {
  cat >&2 <<'EOF'
usage: phone-tether-cycle [--yes]

Switches USB to MTP so RNDIS is off while adb stays up, runs net-check, then
locks and unlocks the phone to apply the screen-unlocked rndis,adb functions
again and verifies the tether with phone-usb-tether-check. --yes skips the
prompt.
EOF
}

yes=0
while [ $# -gt 0 ]; do
  case $1 in
    --yes) yes=1 ;;
    -h | --help) usage; exit 0 ;;
    *)
      usage
      die "unknown argument: $1"
      ;;
  esac
  shift
done

here=$(dirname -- "$(readlink -f -- "$0")")
net_check=${PHONE_NET_CHECK:-$here/net-check}
tether_check=${PHONE_TETHER_CHECK:-$here/phone-usb-tether-check}
for tool in "$net_check" "$tether_check"; do
  [ -x "$tool" ] || die "missing helper: $tool"
done
unlock_bin=${PHONE_UNLOCK:-}
if [ -z "$unlock_bin" ]; then
  unlock_bin=$(phone_ui_unlock_bin) || die "phone-unlock not found (set PHONE_UNLOCK)"
fi
[ -x "$unlock_bin" ] || die "missing helper: $unlock_bin"

disable_tries=${PHONE_DISABLE_TRIES:-15}
restore_tries=${PHONE_RESTORE_TRIES:-5}
restore_wait=${PHONE_RESTORE_WAIT:-2}

serial=$(phone_serial) || die "no phone attached (see adb devices)"

usb_config() {
  # Changing USB functions can make the adb client abort as the gadget
  # re-enumerates, so a failed read is an empty state, not a script failure.
  adb -s "$serial" shell getprop sys.usb.config 2>/dev/null | tr -d '\r' | head -1 || true
}
has_rndis() {
  printf '%s' "$1" | grep -qi rndis
}
keyguard_showing() {
  adb -s "$serial" shell dumpsys window policy 2>/dev/null \
    | tr -d '\r' | sed -n 's/^ *showing=\(true\|false\)$/\1/p' | head -1
}

if [ "$yes" -eq 0 ]; then
  printf 'Disable USB tethering briefly on %s? [y/N] ' "$serial" >&2
  answer=""
  read -r answer </dev/tty || answer=""
  case $answer in
    y | Y | yes | YES) ;;
    *) die "aborted" ;;
  esac
fi

restored=0
restore() {
  [ "$restored" -eq 1 ] && return 0
  log "restoring USB tethering"
  tries=0
  while [ "$tries" -lt "$restore_tries" ]; do
    # The framework ignores data functions while locked and applies the
    # screen-unlocked ones on unlock, so set that default first, force the
    # keyguard and then unlock. phone-unlock does nothing if the keyguard is
    # not showing yet, hence the short wait below.
    adb -s "$serial" shell svc usb setScreenUnlockedFunctions rndis,adb \
      >/dev/null 2>&1 || true
    # A blank function means charging: that is the state the framework
    # re-applies the screen-unlocked functions from when the phone unlocks.
    adb -s "$serial" shell svc usb setFunctions >/dev/null 2>&1 || true
    adb -s "$serial" shell input keyevent KEYCODE_SLEEP >/dev/null 2>&1 || true
    waited=0
    while [ "$(keyguard_showing)" != true ] && [ "$waited" -lt 5 ]; do
      sleep 1
      waited=$((waited + 1))
    done
    "$unlock_bin" >/dev/null 2>&1 || true
    sleep "$restore_wait"
    if "$tether_check" >/dev/null 2>&1; then
      restored=1
      return 0
    fi
    tries=$((tries + 1))
  done
  log "warning: USB tethering is still off"
  return 1
}
trap 'restore; exit 130' INT TERM
trap 'if [ "$restored" -eq 0 ]; then restore; fi' EXIT

current=$(usb_config)
if has_rndis "$current"; then
  log "disabling USB tethering (switching to MTP, adb stays up)"
  tries=0
  while has_rndis "$(usb_config)"; do
    # "adb" alone is rejected here and the adb client may abort while the
    # gadget re-enumerates, so re-issue a function the phone accepts.
    adb -s "$serial" shell svc usb setFunctions mtp >/dev/null 2>&1 || true
    sleep 1
    tries=$((tries + 1))
    [ "$tries" -lt "$disable_tries" ] || die "USB tethering did not turn off (usb=$(usb_config))"
  done
  off_config=$(usb_config)
else
  off_config=$current
  log "USB tethering was already off (usb=$current)"
fi

log "running the internet health check"
health=0
health_out=$("$net_check" 2>&1) || health=$?
printf '%s\n' "$health_out" | sed 's/^/  /' >&2

log "enabling USB tethering again"
restore || die "could not restore USB tethering (phone-unlock needs PHONE_PIN, so run with sudo)"

log "tether cycle: off (usb=$off_config), health check exit $health, on (usb=$(usb_config), route healthy)"
if [ "$health" -eq 0 ]; then
  log "the laptop kept internet while tethering was off"
else
  log "the laptop had no internet while tethering was off (expected when the tether is the uplink)"
fi
