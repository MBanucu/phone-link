#!/usr/bin/env bash
# Install or update the phone's SOCKS proxy app over adb.
#
#   phone-proxy-install                install/update from the newest local APK
#   phone-proxy-install FILE.apk ...   install/update from these APK(s)
#   phone-proxy-install --fdroid       download F-Droid's suggested version, install
#   phone-proxy-install --fdroid --check   download it, install nothing
#   phone-proxy-install --pull DIR     copy the installed APK(s) off the phone
#   phone-proxy-install --status       only report what the phone has
#   phone-proxy-install --check FILE   validate APK and phone, install nothing
#
# The proxy service is not exported, so it cannot be started from the shell
# (`am start-foreground-service` is denied for the shell user). After an
# install, open the app once and start the proxy from its UI.
set -eu
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/phone-net.sh"

usage() {
  cat >&2 <<'EOF'
usage: phone-proxy-install [APK...]
       phone-proxy-install --fdroid [--check]
       phone-proxy-install --pull [DIR]
       phone-proxy-install --status
       phone-proxy-install --check APK

Installs or updates the phone's SOCKS proxy app over adb (-r -g), optionally
fetching F-Droid's suggested version first, pulls the installed APK off the
phone for later reinstalls, or reports what is installed.

--fdroid caches downloads in $PHONE_APK_DIR, defaulting to
$XDG_CACHE_HOME/phone-link (or ~/.cache/phone-link), named
<pkg>-<version>-<code>.apk.
EOF
}

mode=install
use_fdroid=0
extra=()
while [ $# -gt 0 ]; do
  case $1 in
    --pull) mode=pull ;;
    --status) mode=status ;;
    --check) mode=check ;;
    --install) mode=install ;;
    --fdroid) use_fdroid=1 ;;
    -h | --help) usage; exit 0 ;;
    --) shift; extra+=("$@"); break ;;
    -*) usage; die "unknown option: $1" ;;
    *) extra+=("$1") ;;
  esac
  shift
done

[ "$mode" = status ] && [ "$use_fdroid" = 1 ] \
  && die "--status does not download; drop --fdroid"
[ "$mode" = pull ] && [ "$use_fdroid" = 1 ] \
  && die "--pull reads the phone, not F-Droid; drop --fdroid"
[ "$use_fdroid" = 1 ] && [ ${#extra[@]} -gt 0 ] \
  && die "--fdroid fetches the APK itself; drop the path argument"

# Two adb transports (USB and Wi-Fi) are normal here, and then bare `adb`
# refuses to run, so every command is pinned to the serial of the phone.
serial=$(phone_serial) || die "no phone attached (see adb devices)"
log "phone: $serial"

remote_paths() {
  adb -s "$serial" shell pm path "$PHONE_PROXY_PKG" 2>/dev/null \
    | tr -d '\r' | sed -n 's/^package://p'
}

installed_version() {
  adb -s "$serial" shell dumpsys package "$PHONE_PROXY_PKG" 2>/dev/null \
    | tr -d '\r' | sed -n 's/^ *versionName=//p' | head -1
}

show_status() {
  local paths version
  paths=$(remote_paths)
  if [ -z "$paths" ]; then
    log "$PHONE_PROXY_PKG: not installed"
    return 1
  fi
  version=$(installed_version)
  log "$PHONE_PROXY_PKG: installed, version ${version:-unknown}"
  printf '%s\n' "$paths" | sed 's/^/  /' >&2
}

# Look in the current directory, then the usual download spots, then the
# repository's apk/ folder, preferring a file whose name says "proxy".
find_apk() {
  local dir f
  local -a files
  shopt -s nullglob
  for dir in "$PWD" "${PHONE_APK_DIR:-}" "$HOME/Downloads" "$HOME/Desktop" \
    "$(dirname -- "$(readlink -f -- "$0")")/../apk"; do
    [ -n "$dir" ] && [ -d "$dir" ] || continue
    files=("$dir"/*.apk)
    [ ${#files[@]} -gt 0 ] || continue
    for f in "${files[@]}"; do
      case $(basename -- "$f") in
        *proxy*)
          printf '%s\n' "$f"
          return 0
          ;;
      esac
    done
    printf '%s\n' "${files[0]}"
    return 0
  done
  return 1
}

# fdroid_latest -> path of the cached APK, downloading F-Droid's suggestion.
# The v1 API gives only the version code, and F-Droid's repo names files by it,
# so no 70 MB index download is needed.  Hashes are not in the v1 API; the APK
# signature is what makes the result trustworthy, and adb rejects a bad file.
fdroid_latest() {
  local api json code name dir file
  api="https://f-droid.org/api/v1/packages/$PHONE_PROXY_PKG"

  json=$(curl -fsSL --max-time 30 "$api") \
    || die "$PHONE_PROXY_PKG is not on F-Droid (or the API is unreachable)"
  code=$(printf '%s' "$json" \
    | sed -n 's/.*"suggestedVersionCode":\([0-9]\{1,\}\).*/\1/p')
  [ -n "$code" ] || die "F-Droid lists no suggested version for $PHONE_PROXY_PKG"
  name=$(printf '%s' "$json" \
    | grep -o "\"versionName\":\"[^\"]*\",\"versionCode\":$code" \
    | sed 's/.*"versionName":"\([^"]*\)".*/\1/' | head -1)
  log "F-Droid: ${name:-versionCode $code} (versionCode $code)"

  dir=${PHONE_APK_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/phone-link}
  # Keyed by versionCode too: a rebuild can keep versionName and still be new.
  file="$dir/${PHONE_PROXY_PKG}-${name:-unknown}-${code}.apk"
  if [ -s "$file" ]; then
    log "cached: $file"
  else
    mkdir -p "$dir"
    curl -fsSL --max-time 300 -o "$file.part" \
      "https://f-droid.org/repo/${PHONE_PROXY_PKG}_${code}.apk" \
      || {
        rm -f "$file.part"
        die "download failed: $PHONE_PROXY_PKG versionCode $code"
      }
    mv -f "$file.part" "$file"
    log "downloaded: $file ($(stat -c %s "$file") bytes)"
  fi
  printf '%s\n' "$file"
}

pull_apks() {
  local dst=${1:-$PWD/apk} p version
  local -a paths
  mapfile -t paths < <(remote_paths)
  [ ${#paths[@]} -gt 0 ] || die "$PHONE_PROXY_PKG is not installed on $serial"

  mkdir -p "$dst"
  for p in "${paths[@]}"; do
    log "pull $p"
    adb -s "$serial" pull "$p" "$dst/" >/dev/null || die "pull failed: $p"
  done

  # A single base.apk gets a self-describing name so reinstalls need no guess.
  if [ ${#paths[@]} -eq 1 ]; then
    version=$(installed_version)
    mv -f "$dst/$(basename -- "${paths[0]}")" \
      "$dst/${PHONE_PROXY_PKG}-${version:-unknown}.apk"
  fi

  ls -l "$dst" >&2
  log "install later with: phone-proxy-install $dst/*.apk"
}

install_apks() {
  local -a apks=("$@")
  if [ ${#apks[@]} -eq 1 ]; then
    adb -s "$serial" install -r -g "${apks[0]}" || die "adb install failed"
  else
    adb -s "$serial" install-multiple -r -g "${apks[@]}" \
      || die "adb install-multiple failed"
  fi
}

case $mode in
  status) show_status ;;
  pull) pull_apks "${extra[@]}" ;;
  check | install)
    local_apks=()
    if [ "$use_fdroid" = 1 ]; then
      apk=$(fdroid_latest)
      local_apks=("$apk")
    elif [ ${#extra[@]} -gt 0 ]; then
      local_apks=("${extra[@]}")
    else
      apk=$(find_apk) \
        || die "no APK found; pass one, or fetch it with --fdroid"
      local_apks=("$apk")
    fi
    for apk in "${local_apks[@]}"; do
      [ -f "$apk" ] || die "not a file: $apk"
      log "APK: $apk ($(stat -c %s "$apk") bytes)"
    done
    if [ "$mode" = check ]; then
      log "check only; nothing installed"
      exit 0
    fi
    install_apks "${local_apks[@]}"
    show_status
    log "open the app once and start the proxy, then run phone-proxy-check"
    ;;
esac
